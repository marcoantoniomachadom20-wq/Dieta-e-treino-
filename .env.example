# Porta e diretório de dados (banco SQLite + fotos). Em produção, use um disco persistente.
PORT=3001
DATA_DIR=./data

# Chave da API da Anthropic para a análise de refeições por foto. Sem ela, a função fica desativada
# (o app continua funcionando com registro manual). Nunca coloque a chave no frontend.
ANTHROPIC_API_KEY=
# Modelo usado na análise (padrão: claude-opus-5-5).
AI_MODEL=claude-opus-5-5

# Cadastro: por padrão só o primeiro usuário pode se cadastrar. "true" reabre para novos usuários.
ALLOW_REGISTRATION=false

# Cookies "Secure" (só HTTPS). Padrão: true em produção. Use false apenas para testar em http://localhost.
# COOKIE_SECURE=true
